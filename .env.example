# MiniSIEM X Environment Configuration Example
SECRET_KEY=minisiemx-super-secret-key-soc-platform-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite by default, PostgreSQL supported)
# DATABASE_URL=postgresql://user:password@localhost:5432/minisiemx
DATABASE_URL=sqlite:///data/database/minisiemx.db

# Ingestion & Detection Thresholds
MAX_UPLOAD_SIZE_MB=25
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=120
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=60
CORRELATION_WINDOW_SECONDS=300
ALERT_COOLDOWN_SECONDS=180

